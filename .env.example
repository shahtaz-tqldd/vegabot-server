APP_ENV=dev
APP_SECRET=django-insecure-change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8013
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=Asia/Dhaka

# database
DB_NAME=vegabot_db
DB_USER=vegabot_admin
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5432
ADK_DB_URL=postgresql://vegabot_admin:admin123@localhost/adk_session_db
CACHE_URL=redis://redis:6379/2

# google cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
GOOGLE_CLOUD_LIVE_CHAT_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json

# gemini
AGENT_CLIENT_DEBUG=True
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_CHAT_MODEL=gemini-3.8-live
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_RANKING_MODEL=semantic-ranker-default@latest

# gemini pricing, USD
GEMINI_INPUT_COST_PER_MILLION=0.30
GEMINI_OUTPUT_COST_PER_MILLION=2.50
GEMINI_LIVE_TEXT_INPUT_COST_PER_MILLION=0.75
GEMINI_LIVE_AUDIO_INPUT_COST_PER_MILLION=3.00
GEMINI_LIVE_MEDIA_INPUT_COST_PER_MILLION=1.00
GEMINI_LIVE_TEXT_OUTPUT_COST_PER_MILLION=4.50
GEMINI_LIVE_AUDIO_OUTPUT_COST_PER_MILLION=12.00
GEMINI_LIVE_AUDIO_INPUT_COST_PER_MINUTE=0.005
GEMINI_LIVE_AUDIO_OUTPUT_COST_PER_MINUTE=0.018

# email
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Vegabot <you@example.com>

# celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# cloud storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vegabot-chatbot
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# frontend
USER_FRONTEND_URL=http://localhost:5173

# superadmin
SUPERUSER_NAME="Vegabot Admin"
SUPERUSER_EMAIL=admin@vegabot.ai
SUPERUSER_PASSWORD=admin123

# port
WSGI_PORT=8013
ASGI_PORT=8014
POSTGRES_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
